# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Unreal generated / regenerable
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
!Build/*/**/*.ini

# RoadNet's Build/ source layer (Public/Build, Private/Build) collides with the
# ignore rule above, which targets UE's platform build-config directories, not
# plugin source folders. Un-ignore just these two.
!Plugins/RoadNet/Source/RoadNet/Public/Build/
!Plugins/RoadNet/Source/RoadNet/Private/Build/

# Compiled source
*.dll
*.exe
*.lib
*.pdb
*.obj
*.o
*.a
*.so
*.app
*.ipa
*.apk

# Packaged builds
Packaged/
Builds/

# Precompiled assets
SourceArt/**/*.png
SourceArt/**/*.tga

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Raw art source is tracked, but keep Blender backups out
Art/**/*.blend1
Art/**/*.blend2

# Third-party editor automation tooling (dev only, not part of the game)
Plugins/McpAutomationBridge/
