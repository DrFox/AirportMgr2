SourceArt/**/*.png
SourceArt/**/*.tga

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Raw art source is tracked, but keep Blender backups out
Art/**/*.blend1
Art/**/*.blend2

# Third-party editor automation tooling (dev only, not part of the game)
Plugins/McpAutomationBridge/

# Visual Studio project-upgrade logs - build detritus, regenerated on demand
UpgradeLog*.htm

# Reference screenshots kept alongside the project, not part of it
samples/
